# Salin file ini menjadi .env lalu isi. JANGAN pernah commit file .env ke git.
# Token bot Discord (ambil di https://discord.com/developers/applications)
DISCORD_TOKEN_ARTEMIS=isi_token_bot_artemis_di_sini
DISCORD_TOKEN_MALFOID=isi_token_bot_malfoid_di_sini

# API key AI (satu key bisa dipakai ramai-ramai kalau base_url-nya sama)
OPENAI_API_KEY=isi_api_key_di_sini
